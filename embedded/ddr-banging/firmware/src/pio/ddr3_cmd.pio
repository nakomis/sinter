; DDR3 command/address state machine (SINT-100, see ../../../EXECUTOR.md).
;
; PIO0, GPIOBASE 16. One word per run of identical CK cycles (pio_enc.c):
; [22:0] C/A for the 23 OUT pins (GPIO 18..40: CKE .. A13), [31:23] how many
; more cycles repeat it. Side-set drives CK (bit 0, GPIO 16) and CK# (bit 1,
; GPIO 17). Every CK cycle is 8 SM cycles on every path (four instructions of
; two cycles), in step with the writer (PIO1) and sampler (PIO2).

.pio_version 1   ; RP2350
.program ddr3_cmd
.side_set 2

public start:                       ; once, at start (all three SMs alike):
    pull block      side 0b10       ;   fill the OSR now, not by autopull, so no
                                    ;   SM's first OUT stalls
    nop             side 0b10       ;   while the writer and sampler dispatch
.wrap_target
top:
    out pins, 23    side 0b10 [1]   ; q0: CK low, CK# high; C/A for this cycle (autopull at 32)
    out x, 9        side 0b10 [1]   ; q1: repeats
loop:
    nop             side 0b01 [1]   ; q2: CK rises: the DRAM registers C/A
    jmp x-- rep     side 0b01 [1]   ; q3: another cycle of the same?
.wrap                               ;     no: the next word
rep:
    nop             side 0b10 [1]   ; q0: CK low, the same C/A still on the pins
    jmp loop        side 0b10 [1]   ; q1
